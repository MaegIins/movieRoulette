# Clé API TMDB (v3 auth) — gratuite sur https://www.themoviedb.org/settings/api
# Copie ce fichier en .env et colle ta clé ci-dessous.
# Lue uniquement par server/index.js : jamais exposée au navigateur (pas de préfixe VITE_).
TMDB_API_KEY=

# Port du petit serveur qui proxie TMDB (optionnel, 3001 par défaut).
PORT=3001
